# Local SQLite path. The Prisma schema's datasource reads DATABASE_URL from .env.
DATABASE_URL=file:./db/custom.db

# --- Optional: real OpenAI-compatible embeddings ---
# Uncomment + fill in to swap the hashing-embedder fallback for a real embeddings API.
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# (OR, equivalently, set OPENAI_API_KEY — both work.)
# OPENAI_API_KEY=sk-...

# --- Optional: disable the live LLM stream (use mock provider) ---
# PKC_DISABLE_LLM=1
